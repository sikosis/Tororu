
resource app_signature "application/x-vnd.sikosis-Tororu";

resource file_types message {
	"types" = "text/html",
	"types" = "text/plain",
	"types" = "application/x-vnd.Be-bookmark"
};

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 7,

	variety = B_APPV_DEVELOPMENT,
	internal = 0
};

resource app_flags B_MULTIPLE_LAUNCH;

resource(100, "images/button_back") #'bits' import "images/button_back";
resource(101, "images/button_back_on") #'bits' import "images/button_back_on";
