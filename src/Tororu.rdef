resource(104, "images/button_down_on") #'bits' import "images/button_down_on";
resource(105, "images/button_down_dis") #'bits' import "images/button_down_dis";
resource(106, "images/button_forward") #'bits' import "images/button_forward";
resource(107, "images/button_forward_on") #'bits' import "images/button_forward_on";
resource(108, "images/button_forward_dis") #'bits' import "images/button_forward_dis";
resource(109, "images/button_home") #'bits' import "images/button_home";
resource(110, "images/button_home_on") #'bits' import "images/button_home_on";
resource(111, "images/button_home_dis") #'bits' import "images/button_home_dis";
resource(112, "images/button_search") #'bits' import "images/button_search";
resource(113, "images/button_search_on") #'bits' import "images/button_search_on";
